{
  "name": "@yash/language",
  "version": "0.1.0",
  "description": "YASH (Yet Another SHell) - A portable Bash-like shell interpreter in TypeScript",
  "module": "src/index.ts",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lexer": "./src/interpretor/lexer.ts",
    "./parser": "./src/interpretor/parser.ts",
    "./eval": "./src/interpretor/eval.ts"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --minify",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "keywords": [
    "shell",
    "bash",
    "interpreter",
    "typescript",
    "portable"
  ],
  "author": "Thumuss",
  "license": "MIT"
}
